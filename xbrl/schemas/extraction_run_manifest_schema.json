{
  "schema_name": "extraction_run_manifest_schema",
  "schema_version": "v0.3.5",
  "root_type": "object",
  "required": ["run_id", "prototype_version", "mode", "fixture_format", "company", "ticker", "cik", "accession", "form_type", "reporting_period", "fiscal_year", "fiscal_quarter", "currency", "amount_unit", "per_share_unit", "input_file", "snapshot_sha256", "mapping_file", "mapping_sha256", "mapping_version", "mapping_review_status", "generated_at", "candidate_count", "unresolved_count", "review_status", "fixture_data_status", "output_files", "boundaries"],
  "forbidden_fields": ["target_price", "recommendation", "buy", "sell", "hold", "position_size", "research_status"],
  "properties": {
    "run_id": {"type": "string", "nonblank": true},
    "prototype_version": {"type": "string", "nonblank": true},
    "mode": {"type": "string", "enum": ["offline_fixture_only"]},
    "fixture_format": {"type": "string", "enum": ["data_attr", "inline_like", "instance_xml"]},
    "company": {"type": "string", "nonblank": true},
    "ticker": {"type": "string", "nonblank": true},
    "cik": {"type": "string", "nonblank": true},
    "accession": {"type": "string", "nonblank": true},
    "form_type": {"type": "string", "nonblank": true},
    "reporting_period": {"type": "string", "nonblank": true},
    "fiscal_year": {"type": "string", "nonblank": true},
    "fiscal_quarter": {"type": "string", "nonblank": true},
    "currency": {"type": "string", "nonblank": true},
    "amount_unit": {"type": "string", "nonblank": true},
    "per_share_unit": {"type": "string", "nonblank": true},
    "input_file": {"type": "string", "nonblank": true},
    "snapshot_sha256": {"type": "string", "nonblank": true},
    "mapping_file": {"type": "string", "nonblank": true},
    "mapping_sha256": {"type": "string", "nonblank": true},
    "mapping_version": {"type": "string", "nonblank": true},
    "mapping_review_status": {"type": "string", "enum": ["prototype_fixture_only"]},
    "generated_at": {"type": "string", "nonblank": true},
    "candidate_count": {"type": "number", "finite": true},
    "unresolved_count": {"type": "number", "finite": true},
    "review_status": {"type": "string", "enum": ["draft_extracted_unreviewed"]},
    "fixture_data_status": {"type": "string", "enum": ["fictional_sample", "synthetic_unverified_real_company_shape"]},
    "overwrite_used": {"type": "boolean"},
    "output_files": {"type": "array"},
    "boundaries": {"type": "array"}
  }
}
