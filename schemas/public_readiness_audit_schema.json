{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Readiness Audit",
  "type": "object",
  "required": [
    "audit_schema_version",
    "created_at",
    "ready_for_public_release",
    "reason",
    "checks"
  ],
  "properties": {
    "audit_schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "ready_for_public_release": {
      "type": "boolean",
      "const": false
    },
    "reason": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "passed", "notes"],
        "properties": {
          "check": {"type": "string"},
          "passed": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "forbidden_fields": [
    "target_price",
    "recommendation",
    "buy",
    "sell",
    "hold",
    "position_size",
    "research_status",
    "trading_action"
  ]
}
