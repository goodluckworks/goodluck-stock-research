{
  "schema_name": "promotion_manifest_schema",
  "schema_version": "v0.3.5",
  "root_type": "object",
  "block_real_company_promotion": true,
  "required": ["promotion_id", "created_at", "generated_at", "review_file", "candidate_file", "extraction_manifest_file", "extraction_run_id", "review_batch_id", "snapshot_sha256", "mapping_version", "mapping_review_reference", "review_decision_log_reference", "quality_score_reference", "package_audit_reference", "ticker", "fictional_company", "allow_real_company_promotion_used", "promoted_count", "excluded_count", "promoted_fields", "excluded_fields", "promotion_status", "output_files"],
  "forbidden_fields": ["target_price", "recommendation", "buy", "sell", "hold", "position_size", "research_status"],
  "properties": {
    "promotion_id": {"type": "string", "nonblank": true},
    "created_at": {"type": "string", "nonblank": true},
    "generated_at": {"type": "string", "nonblank": true},
    "review_file": {"type": "string", "nonblank": true},
    "candidate_file": {"type": "string", "nonblank": true},
    "extraction_manifest_file": {"type": "string", "nonblank": true},
    "extraction_run_id": {"type": "string", "nonblank": true},
    "review_batch_id": {"type": "string", "nonblank": true},
    "snapshot_sha256": {"type": "string", "nonblank": true},
    "mapping_version": {"type": "string", "nonblank": true},
    "mapping_review_reference": {"type": "string", "nonblank": true},
    "review_decision_log_reference": {"type": "string", "nonblank": true},
    "quality_score_reference": {"type": "string", "nonblank": true},
    "package_audit_reference": {"type": "string", "nonblank": true},
    "ticker": {"type": "string", "nonblank": true},
    "fictional_company": {"type": "boolean"},
    "allow_real_company_promotion_used": {"type": "boolean"},
    "promoted_count": {"type": "number", "finite": true},
    "excluded_count": {"type": "number", "finite": true},
    "promoted_fields": {"type": "array"},
    "excluded_fields": {"type": "array"},
    "promotion_status": {"type": "string", "enum": ["fictional_draft_promoted"]},
    "overwrite_used": {"type": "boolean"},
    "output_files": {"type": "array"}
  }
}
